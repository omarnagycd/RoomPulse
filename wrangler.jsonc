{
  "name": "roompulse",
  "main": "worker.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hall-polls",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "durable_objects": {"bindings": [{"name": "ROOM", "class_name": "QuizRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["QuizRoom"]}],
  "observability": {
    "enabled": false
  },
  "preview_urls": false
}
